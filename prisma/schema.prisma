generator client {
  provider = "prisma-client-js"
}

// The provider is "postgresql" for production deployments.
// For local development with SQLite, override DATABASE_URL in .env to point
// to a SQLite file (e.g. DATABASE_URL="file:./dev.db") and set the provider
// to "sqlite" in a local-only schema branch, or use `prisma db push`
// with an explicit DATABASE_URL. The Prisma schema stays PostgreSQL-native
// so production deploys work without modification.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  subscriptionTier   String    @default("SOLO") // SOLO, TEAM, ENTERPRISE
  trialStartDate     DateTime?
  trialEndDate       DateTime?
  subscriptionStatus String    @default("TRIAL") // TRIAL, ACTIVE, EXPIRED, CANCELLED
  stripeCustomerId   String?
  stripeSubscriptionId String?
  googleRefreshToken  String?
  googleAccessToken   String?
  googleTokenExpiry   Int?
  googleConnected     Boolean  @default(false)
  microsoftRefreshToken  String?
  microsoftAccessToken   String?
  microsoftTokenExpiry   Int?
  microsoftConnected     Boolean  @default(false)
  lastNotificationGeneration DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users         User[]
  entities      Entity[]
  projects      Project[]
  tasks         Task[]
  documents     Document[]
  contacts      Contact[]
  contactRelations ContactRelation[]
  contactMerges  ContactMerge[]
  meetings      Meeting[]
  notifications Notification[]
  comments      Comment[]
  auditLogs     AuditLog[]
  executiveNotes ExecutiveNote[]
  supportTokens SupportAccessToken[]
  taskEvents    TaskEvent[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash   String?
  image          String?
  resetToken     String?      @unique
  resetTokenExpiry DateTime?
  role           String       @default("STAFF") // OWNER, EXECUTIVE_ASSISTANT, OPERATIONS_MANAGER, STAFF, READ_ONLY
  isSuperAdmin   Boolean      @default(false)
  status         String       @default("ACTIVE") // ACTIVE, PENDING
  inviteToken    String?      @unique
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  assignedTasks   Task[]         @relation("TaskAssignee")
  createdTasks    Task[]         @relation("TaskCreator")
  waitingOnTasks  Task[]         @relation("TaskWaitingOn")
  uploadedDocs    Document[]     @relation("DocumentUploader")
  accounts        Account[]
  sessions        Session[]
  notifications   Notification[]
  comments        Comment[]
  auditLogs       AuditLog[]
  executiveNotes  ExecutiveNote[]
  reviewedTasks   Task[]         @relation("TaskReviewer")
  ownedProjects   Project[]      @relation("ProjectOwner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Entity {
  id             String       @id @default(cuid())
  name           String
  type           String       // BUSINESS, HOTEL, GAS_STATION, COMMERCIAL_PROPERTY, INVESTMENT, OTHER
  metadata       String       @default("{}") // JSON string for type-specific fields
  organizationId String
  isSample       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  projects       Project[]
  tasks          Task[]
  documents      Document[]
  contacts       Contact[]
  contactRelations ContactRelation[]

  // ── Command-center depth (Phase 4e; additive / nullable) ─────────────────
  // Entity hierarchy (child entities under a parent, e.g. portfolio company
  // under an SPV) and the entity's designated owner contact. Both are optional
  // and purely additive — existing rows are untouched (NULL).
  parentEntityId String?
  ownerContactId String?

  parent        Entity?   @relation("EntityChildren", fields: [parentEntityId], references: [id])
  childEntities Entity[]  @relation("EntityChildren")
  ownerContact  Contact?  @relation("ContactEntityOwner", fields: [ownerContactId], references: [id])

  @@index([organizationId])
  @@index([parentEntityId])
}

model Project {
  id             String       @id @default(cuid())
  name           String
  description    String?
  status         String       @default("ACTIVE") // ACTIVE, ON_HOLD, COMPLETED, CANCELLED
  phase          String       @default("ACQUISITION") // ACQUISITION, DUE_DILIGENCE, DESIGN, PERMITTING, CONSTRUCTION, CLOSEOUT, OPERATIONS
  progress       Int          @default(0)
  budget         Float?
  startDate      DateTime?
  targetDate     DateTime?
  organizationId String
  entityId       String?
  isSample       Boolean      @default(false)
  // Command-center depth (Phase 4e; additive / nullable): the org user who
  // owns this project. NULL means unassigned — purely additive.
  ownerUserId    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  entity         Entity?      @relation(fields: [entityId], references: [id])
  ownerUser      User?        @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  tasks          Task[]
  documents      Document[]
  meetings       Meeting[]

  @@index([organizationId])
  @@index([ownerUserId])
}

model Task {
  id              String       @id @default(cuid())
  title           String
  description     String?
  status          String       @default("TODO") // TODO, IN_PROGRESS, DONE, BLOCKED, WAITING_ON, READY_FOR_REVIEW
  priority        String       @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  dueDate         DateTime?
  category        String?
  organizationId  String
  projectId       String?
  entityId        String?
  assigneeId      String?
  createdById     String?
  dependsOnId     String?
  waitingOnUserId String?
  notes           String?
  aiSuggestion    String?
  aiSuggestionGeneratedAt DateTime?
  isSample        Boolean      @default(false)

  // ── Status-workflow capture (Phase 1d) ──
  blockedReason       String?
  blockedSince        DateTime?
  waitingOn           String?
  waitingOnSince      DateTime?
  expectedResolutionDate DateTime?
  escalationOwner     String?
  reviewRequestedAt   DateTime?
  reviewRequiredBy    DateTime?
  reviewedById        String?
  reviewedAt          DateTime?
  approvalStatus      String?   // PENDING, APPROVED, CHANGES_REQUESTED, REJECTED

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  project         Project?     @relation(fields: [projectId], references: [id])
  entity          Entity?      @relation(fields: [entityId], references: [id])
  assignee        User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy       User?        @relation("TaskCreator", fields: [createdById], references: [id])
  dependsOn       Task?        @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependedBy      Task[]       @relation("TaskDependency")
  waitingOnUser   User?        @relation("TaskWaitingOn", fields: [waitingOnUserId], references: [id])
  reviewer        User?        @relation("TaskReviewer", fields: [reviewedById], references: [id])
  comments        Comment[]
  events          TaskEvent[]

  @@index([organizationId])
  @@index([reviewedById])
}

model TaskEvent {
  id             String   @id @default(cuid())
  taskId         String
  actorId        String?
  actorName      String?
  action         String   // STATUS_CHANGE, ASSIGNEE_CHANGE, DUE_CHANGE, BLOCKED, WAITING_ON, REVIEW_SUBMITTED, REVIEW_APPROVED, REVIEW_REQUESTED_CHANGES, REVIEW_REJECTED, COMMENT, AI_REFRESH, NOTE
  details        Json?
  at             DateTime @default(now())
  organizationId String

  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([taskId, at])
  @@index([organizationId])
}

model Document {
  id             String       @id @default(cuid())
  name           String
  type           String       // CONTRACT, PURCHASE_AGREEMENT, LEASE, INSURANCE, LICENSE, TAX, FINANCIAL_STATEMENT, PHOTO, PDF, OTHER
  url            String?
  filePath       String?
  notes          String?
  content        String?
  organizationId String
  projectId      String?
  entityId       String?
  uploadedById   String?
  isSample       Boolean      @default(false)

  // ── Document intelligence (Phase 3b) ──
  // Nullable / additive: expiry tracking + optional attention flag. When
  // `expiryDate` is set, the shared needs-attention module computes
  // EXPIRING_SOON (within 30 days) / EXPIRED automatically. `attention` is an
  // optional operator-set reason string (e.g. "RENEW", "REVIEW", "FLAGGED") to
  // force the document into the briefing regardless of expiry.
  expiryDate   DateTime?
  expiryNote   String?
  attention    String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  project        Project?     @relation(fields: [projectId], references: [id])
  entity         Entity?      @relation(fields: [entityId], references: [id])
  uploadedBy     User?        @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([organizationId])
}

model Contact {
  id             String       @id @default(cuid())
  name           String
  company        String?
  position       String?
  phone          String?
  email          String?
  organizationId String
  // entityId is the contact's PRIMARY/home entity (back-compat for the flat
  // model). Full multi-entity membership lives on ContactRelation — a person is
  // ONE Contact with N relations. entityId stays nullable and additive.
  entityId       String?
  notes          String?
  isSample       Boolean      @default(false)
  // ── Contact merge reversibility (Phase 4d) ──────────────────────────────
  // When a contact is absorbed into a keeper during an owner-confirmed merge,
  // the row is NOT deleted — it is kept and marked so the merge can be reversed
  // (unmerged) from a stored ContactMerge record. `mergedIntoId` points at the
  // keeper contact that absorbed this one; NULL means not currently absorbed.
  mergedIntoId   String?
  mergedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  entity         Entity?      @relation(fields: [entityId], references: [id])
  relations      ContactRelation[]
  entitiesOwned  Entity[]     @relation("ContactEntityOwner")
  mergedInto     Contact?      @relation("ContactMergeInto", fields: [mergedIntoId], references: [id])
  mergedContacts Contact[]     @relation("ContactMergeInto")
  mergesAsKeeper ContactMerge[] @relation("ContactMergeKeeper")
  mergesAsMerged ContactMerge[] @relation("ContactMergeMerged")

  @@index([organizationId])
}

// ── Contact merge history / reversibility record (Phase 4d) ────────────────
// One row per absorbed contact per merge. Stores a full JSON snapshot of the
// merged-away contact's pre-merge state (relations, primary entity, copied
// fields, note lines appended to the keeper) so a previous merge can be
// reversed cleanly. Idempotent: re-requesting a completed merge/its unmerge
// is a no-op. `status` flips MERGED -> UNMERGED once reversed (row retained for
// an honest audit trail).
model ContactMerge {
  id             String   @id @default(cuid())
  organizationId String
  keeperId       String
  mergedId       String
  snapshot       Json
  status         String   @default("MERGED") // MERGED, UNMERGED
  mergedBy       String?
  mergedAt       DateTime @default(now())
  unmergedBy     String?
  unmergedAt     DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id])
  keeper         Contact     @relation("ContactMergeKeeper", fields: [keeperId], references: [id], onDelete: Cascade)
  mergedContact  Contact     @relation("ContactMergeMerged", fields: [mergedId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keeperId])
}

// ── Contact ↔ Entity relationship (Phase 3a: dedup structural fix) ──────────
// One real person = ONE Contact row. Each entity they relate to is a row in
// ContactRelation (role/title + enablement + per-entity notes). This removes
// the structural duplicate-contact problem of the flat single-entityId model.
model ContactRelation {
  id             String   @id @default(cuid())
  contactId      String
  entityId       String
  // role/title at that entity, e.g. "CEO", "Board", "Vendor rep", "Manager"
  role           String?
  enabled        Boolean  @default(true)
  // Per-entity notes about this person's involvement at that entity
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  entity       Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([contactId, entityId])
  @@index([entityId])
  @@index([organizationId])
}

model Meeting {
  id             String       @id @default(cuid())
  title          String
  date           DateTime
  location       String?
  organizationId String
  projectId      String?
  notes          String?
  isSample       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  project        Project?     @relation(fields: [projectId], references: [id])

  @@index([organizationId])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  type           String       // DEADLINE, OVERDUE, STALLED, RENEWAL, MENTION, ASSIGNED, COMPLETED, WAITING, UNBLOCKED
  title          String
  message        String
  link           String?
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model Comment {
  id             String       @id @default(cuid())
  content        String
  taskId         String
  authorId       String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([taskId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  action         String       // CREATE, UPDATE, DELETE
  entity         String       // what was acted on (Task, Project, etc.)
  entityId       String       // id of the record
  details        String?      // optional JSON with change details
  isSupportMode  Boolean      @default(false)
  supportActorId String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model SupportAccessToken {
  id             String    @id @default(cuid())
  organizationId String
  token          String    @unique
  permissions    String    @default("READ") // READ, READ_WRITE
  expiresAt      DateTime
  revokedAt      DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([token])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
  processedAt DateTime @default(now())
}

model ExecutiveNote {
  id             String   @id @default(cuid())
  content        String   @default("")
  userId         String   @unique
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContentPost {
  id            String    @id @default(cuid())
  title         String
  body          String
  status        String    @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, ARCHIVED
  platform      String    @default("LINKEDIN")
  scheduledDate DateTime?
  publishedDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
