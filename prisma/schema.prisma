generator client {
  provider = "prisma-client-js"
}

// The provider is "postgresql" for production deployments.
// For local development with SQLite, override DATABASE_URL in .env to point
// to a SQLite file (e.g. DATABASE_URL="file:./dev.db") and set the provider
// to "sqlite" in a local-only schema branch, or use `prisma db push`
// with an explicit DATABASE_URL. The Prisma schema stays PostgreSQL-native
// so production deploys work without modification.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  subscriptionTier   String    @default("SOLO") // SOLO, TEAM, ENTERPRISE
  trialStartDate     DateTime?
  trialEndDate       DateTime?
  subscriptionStatus String    @default("TRIAL") // TRIAL, ACTIVE, EXPIRED, CANCELLED
  stripeCustomerId   String?
  stripeSubscriptionId String?
  googleRefreshToken  String?
  googleAccessToken   String?
  googleTokenExpiry   Int?
  googleConnected     Boolean  @default(false)
  microsoftRefreshToken  String?
  microsoftAccessToken   String?
  microsoftTokenExpiry   Int?
  microsoftConnected     Boolean  @default(false)
  lastNotificationGeneration DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users         User[]
  entities      Entity[]
  projects      Project[]
  tasks         Task[]
  documents     Document[]
  contacts      Contact[]
  meetings      Meeting[]
  notifications Notification[]
  comments      Comment[]
  auditLogs     AuditLog[]
  executiveNotes ExecutiveNote[]
  supportTokens SupportAccessToken[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash   String?
  image          String?
  resetToken     String?      @unique
  resetTokenExpiry DateTime?
  role           String       @default("STAFF") // OWNER, EXECUTIVE_ASSISTANT, OPERATIONS_MANAGER, STAFF, READ_ONLY
  status         String       @default("ACTIVE") // ACTIVE, PENDING
  inviteToken    String?      @unique
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  assignedTasks   Task[]         @relation("TaskAssignee")
  createdTasks    Task[]         @relation("TaskCreator")
  waitingOnTasks  Task[]         @relation("TaskWaitingOn")
  uploadedDocs    Document[]     @relation("DocumentUploader")
  accounts        Account[]
  sessions        Session[]
  notifications   Notification[]
  comments        Comment[]
  auditLogs       AuditLog[]
  executiveNotes  ExecutiveNote[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Entity {
  id             String       @id @default(cuid())
  name           String
  type           String       // BUSINESS, HOTEL, GAS_STATION, COMMERCIAL_PROPERTY, INVESTMENT, OTHER
  metadata       String       @default("{}") // JSON string for type-specific fields
  organizationId String
  isSample       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  projects       Project[]
  tasks          Task[]
  documents      Document[]
  contacts       Contact[]

  @@index([organizationId])
}

model Project {
  id             String       @id @default(cuid())
  name           String
  description    String?
  status         String       @default("ACTIVE") // ACTIVE, ON_HOLD, COMPLETED, CANCELLED
  phase          String       @default("ACQUISITION") // ACQUISITION, DUE_DILIGENCE, DESIGN, PERMITTING, CONSTRUCTION, CLOSEOUT, OPERATIONS
  progress       Int          @default(0)
  budget         Float?
  startDate      DateTime?
  targetDate     DateTime?
  organizationId String
  entityId       String?
  isSample       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  entity         Entity?      @relation(fields: [entityId], references: [id])
  tasks          Task[]
  documents      Document[]
  meetings       Meeting[]

  @@index([organizationId])
}

model Task {
  id              String       @id @default(cuid())
  title           String
  description     String?
  status          String       @default("TODO") // TODO, IN_PROGRESS, DONE, BLOCKED, WAITING_ON, READY_FOR_REVIEW
  priority        String       @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  dueDate         DateTime?
  category        String?
  organizationId  String
  projectId       String?
  entityId        String?
  assigneeId      String?
  createdById     String?
  dependsOnId     String?
  waitingOnUserId String?
  notes           String?
  aiSuggestion    String?
  isSample        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  project         Project?     @relation(fields: [projectId], references: [id])
  entity          Entity?      @relation(fields: [entityId], references: [id])
  assignee        User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy       User?        @relation("TaskCreator", fields: [createdById], references: [id])
  dependsOn       Task?        @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependedBy      Task[]       @relation("TaskDependency")
  waitingOnUser   User?        @relation("TaskWaitingOn", fields: [waitingOnUserId], references: [id])
  comments        Comment[]

  @@index([organizationId])
}

model Document {
  id             String       @id @default(cuid())
  name           String
  type           String       // CONTRACT, PURCHASE_AGREEMENT, LEASE, INSURANCE, LICENSE, TAX, FINANCIAL_STATEMENT, PHOTO, PDF, OTHER
  url            String?
  filePath       String?
  notes          String?
  organizationId String
  projectId      String?
  entityId       String?
  uploadedById   String?
  isSample       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  project        Project?     @relation(fields: [projectId], references: [id])
  entity         Entity?      @relation(fields: [entityId], references: [id])
  uploadedBy     User?        @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([organizationId])
}

model Contact {
  id             String       @id @default(cuid())
  name           String
  company        String?
  position       String?
  phone          String?
  email          String?
  organizationId String
  entityId       String?
  notes          String?
  isSample       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  entity         Entity?      @relation(fields: [entityId], references: [id])

  @@index([organizationId])
}

model Meeting {
  id             String       @id @default(cuid())
  title          String
  date           DateTime
  location       String?
  organizationId String
  projectId      String?
  notes          String?
  isSample       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  project        Project?     @relation(fields: [projectId], references: [id])

  @@index([organizationId])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  type           String       // DEADLINE, OVERDUE, STALLED, RENEWAL, MENTION, ASSIGNED, COMPLETED, WAITING, UNBLOCKED
  title          String
  message        String
  link           String?
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model Comment {
  id             String       @id @default(cuid())
  content        String
  taskId         String
  authorId       String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([taskId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  action         String       // CREATE, UPDATE, DELETE
  entity         String       // what was acted on (Task, Project, etc.)
  entityId       String       // id of the record
  details        String?      // optional JSON with change details
  isSupportMode  Boolean      @default(false)
  supportActorId String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model SupportAccessToken {
  id             String    @id @default(cuid())
  organizationId String
  token          String    @unique
  permissions    String    @default("READ") // READ, READ_WRITE
  expiresAt      DateTime
  revokedAt      DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([token])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
  processedAt DateTime @default(now())
}

model ExecutiveNote {
  id             String   @id @default(cuid())
  content        String   @default("")
  userId         String   @unique
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}
